# ==========================================
# VAAYIL AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Gnani.ai Credentials (CRITICAL: Never commit your real API key)
# Get your API key from the Gnani API dashboard (https://docs.gnani.ai)
# Pass in backend environment variables only. Frontend never touches this key.
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai

# STT (Prisma) Settings
# Supported models: prisma-v3.0, prisma-v2.5
GNANI_STT_MODEL=prisma-v3.0

# TTS (Timbre) Settings
# Supported models: timbre-v3.0 (recommended), timbre-v2.5
# Supported Tamil v3 voices: Shivani, Kalpana, Lakshmi, Avinash, Devansh, Prakash, etc.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# Application & Authentication
JWT_SECRET=vaayil_ai_super_secret_jwt_key_2026_internship_demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./vaayil.db

# App Environment & Security
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

